# Default target profile for Raspberry Pi CM4 / Raspberry Pi 4 on OpenWrt 24.10.x
OPENWRT_VERSION="24.10.6"
OPENWRT_TARGET="bcm27xx/bcm2711"
OPENWRT_PROFILE="rpi-4"
OPENWRT_ROOT="https://downloads.openwrt.org/releases/${OPENWRT_VERSION}/targets/${OPENWRT_TARGET}"
PACKAGES_FILE="packages/araneae-24.10-base.txt"
OPENWRT_ROOTFS_PARTSIZE_MB="1024"
OPENWRT_MAKE_VERBOSE="s"
SSH_SERVER="dropbear"
ARANAE_HOSTNAME="araneae"
ARANAE_LAN_IP="192.168.8.1"
ARANAE_LAN_NETMASK="255.255.255.0"
ARANAE_WG_SERVER_IP="10.66.66.1"
ARANAE_WG_CIDR="10.66.66.1/24"
ARANAE_WG_PORT="51820"
ARANAE_MATTERMOST_PORT="8065"
